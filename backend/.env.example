# Copy this file to backend/.env. Never commit actual credentials.

# Embedding model: downloaded on first use, then cached locally.
# Change to BAAI/bge-m3 for a larger multilingual model.
# A local directory such as models/all-MiniLM-L6-v2 also works.
SCHOLAR_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCHOLAR_OFFLINE=0
# Use an explicit topic count, or auto for silhouette-based selection.
SCHOLAR_CLUSTER_COUNT=4
# Optional Hugging Face mirror if model downloads are unavailable:
# HF_ENDPOINT=https://hf-mirror.com

# Default LLM. No API key is needed for the graphics demo.
SCHOLAR_LLM_PROVIDER=local
SCHOLAR_OLLAMA_MODEL=qwen2.5:3b
SCHOLAR_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Optional proxy: auto, direct, or an explicit proxy URL.
SCHOLAR_LLM_PROXY=auto
NO_PROXY=127.0.0.1,localhost

# Native extraction first, OCR only when page text quality is low.
# Tesseract is an optional external executable with language packs.
SCHOLAR_OCR_ENABLED=auto
SCHOLAR_OCR_LANG=chi_sim+eng
SCHOLAR_OCR_ZOOM=2.0
SCHOLAR_OCR_MIN_QUALITY=0.55
SCHOLAR_TESSERACT_CMD=

# Optional MinerU parser, installed separately.
SCHOLAR_MINERU_CMD=
SCHOLAR_MINERU_LANG=ch
SCHOLAR_MINERU_BACKEND=pipeline
SCHOLAR_MINERU_TIMEOUT=900

# Optional legacy Spark settings. Supply your own credentials if used.
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
